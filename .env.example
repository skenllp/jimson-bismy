# ---- Required ----
# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD]. Used ONLY on the server (never exposed to the browser).
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Long random string (32+ chars). Signs QR tokens, confirmation links and admin sessions.
#   openssl rand -base64 48
APP_SECRET=

# Admin dashboard access codes (10+ chars each). Admin = everything. Staff = check-in + guest search only.
ADMIN_PASSWORD=
STAFF_PASSWORD=

# ---- Optional ----
# Public wishes are hidden until approved. Set to true to publish new (non-private) wishes immediately.
WISHES_AUTO_APPROVE=false
# Your production URL, used for og:url / og:image / canonical (Vercel fills VERCEL_PROJECT_PRODUCTION_URL automatically).
SITE_URL=
# Local Postgres without SSL:  PGSSL=disable
